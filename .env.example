# OMMO / India IRL — copy to `.env.local` (Next) or set in your host’s env UI.
# Never commit real secrets. NEXT_PUBLIC_* is embedded at build time.

# --- Frontend (Next.js @ apps/web) ---
# Public WebSocket URL for the relay (use wss:// in production).
NEXT_PUBLIC_RELAY_URL=ws://localhost:8787

# Optional: HTTP base for SSR Open Graph /stats (defaults from NEXT_PUBLIC_RELAY_URL).
# RELAY_HTTP_URL=http://localhost:8787

# Optional TURN for proximity voice across restrictive NATs (comma-separated URLs).
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# --- Relay (server/relay.mjs) ---
PORT=8787
MAX_PER_ROOM=60

# Comma-separated allowed Origin / Referer hosts for HTTP + WS upgrade.
# Empty = allow all (dev). Production example:
# ALLOWED_ORIGINS=https://ommo.example.com,https://www.ommo.example.com
ALLOWED_ORIGINS=
