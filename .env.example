# OMMO / India IRL — copy to `.env.local` for local Next, or set in Vercel / Fly UI.
# Never commit real secrets. NEXT_PUBLIC_* is embedded at **build** time on Vercel.

# =============================================================================
# Frontend (Next.js — Vercel or `npm run build && npm start`)
# =============================================================================

# Public WebSocket URL for the relay.
# Local:  ws://localhost:8787
# Prod:   wss://ommo-relay.fly.dev   (MUST be wss:// on HTTPS sites)
NEXT_PUBLIC_RELAY_URL=ws://localhost:8787

# HTTP base for SSR Open Graph /stats (defaults from NEXT_PUBLIC_RELAY_URL).
# Prod:   https://ommo-relay.fly.dev
# RELAY_HTTP_URL=http://localhost:8787

# Optional TURN for proximity voice across restrictive NATs (comma-separated).
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# =============================================================================
# Relay (server/relay.mjs — Fly.io or `npm run relay`)
# =============================================================================

PORT=8787
HOST=0.0.0.0
MAX_PER_ROOM=60
NODE_ENV=production

# Comma-separated allowed browser Origins for HTTP + WS upgrade.
# Empty = allow all (dev only). After Vercel deploy, lock this down:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://ommo.example.com
ALLOWED_ORIGINS=
